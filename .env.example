# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead (never commit real values).

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=syneolab

# Exact public address employees use, no trailing slash
APP_URL=https://work.yourcompany.com

# Optional: Gmail meeting invitations (use a Google app password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Google Sheets lead sync (see integrations/google-sheets.gs)
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_SECRET=

# Optional: Auto Google Calendar + Google Meet room creation (see integrations/google-calendar-meet.gs)
GOOGLE_CALENDAR_URL=
GOOGLE_CALENDAR_SECRET=
